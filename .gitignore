# 生成物
projects/**/audio/
projects/**/frames/
projects/**/out/
projects/**/llm/
projects/**/build.log
projects/**/.approved
projects/**/.release
projects/**/.uploaded
projects/_failed_script.txt
projects/_prompt_script.md
ideas/prompt.md
*_list.txt

# プレースホルダー素材（ytf assets --init で再生成可能）
assets/backgrounds/default.png
assets/bgm/*
!assets/bgm/.gitkeep
!assets/bgm/SOURCES.md
assets/clips/*
!assets/clips/SOURCES.md
assets/se/*
!assets/se/SOURCES.md
assets/op.mp4

# ダウンロードした素材（ytf media）
media/

# APIキー等の秘密（絶対にコミットしない）
.pexels_key
.env

# Python
__pycache__/
*.egg-info/
.venv/
build/
dist/
# 立ち絵素材（二次配布禁止のためコミットしない。入手元は assets/characters/SOURCES.md）
assets/characters/*
!assets/characters/SOURCES.md
# 外部バイナリ置き場。OSごとに入れ直すものなのでコミットしない（入手方法は SETUP_WINDOWS.md 参照）
#   旧来は tools/ffmpeg など個別指定だったが、Windows の .exe や
#   tools/BouyomiChan/ が漏れて公開リポジトリに200MB入りかけたため、丸ごと除外に変更（2026-09-20）
#   ※ 自作スクリプトは tools/ ではなく scripts/ に置くこと
tools/
.DS_Store
assets/fonts/*.ttf
assets/fonts/*.otf
assets/fonts/*.ttc
# Noto Sans JP は SIL OFL（再配布可）。両OSで同じ絵を出すため同梱する
!assets/fonts/NotoSansJP-Black.otf
!assets/fonts/NotoSansJP-Bold.otf


# YouTube Data API の認証情報（絶対にコミットしない）
client_secret.json
.youtube_token.json

# Mac からの移行時の受け渡しフォルダ（client_secret.json が入る。publicリポジトリのため絶対にコミットしない）
Windows移行用/
